# Copia in .env e compila.

# OpenRouter (https://openrouter.ai/keys) — usato solo con endpoint zero-data-retention di Mistral (UE)
OPENROUTER_API_KEY=

# Supabase (locale: `npx supabase start` stampa questi valori)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:5610
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Firma dei cookie di sblocco dell'area genitore: `openssl rand -hex 32`
PARENT_UNLOCK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:5600
